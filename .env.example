# Local API authentication. Change this before exposing the service.
GEMINI_API_KEY=change-me-local-key
# Use a different secret for Cookie/account administration.
GEMINI_ADMIN_TOKEN=change-me-admin-token

GEMINI_MODEL=gemini-3-flash
GEMINI_ADVANCED_MODEL=gemini-3-pro
GEMINI_HOST=127.0.0.1
GEMINI_PORT=8000
GEMINI_TIMEOUT=90
# Set GEMINI_PROXY=direct to explicitly bypass HTTPS_PROXY/ALL_PROXY.
GEMINI_PROXY=
# Advanced/testing override. Normal users should keep the Google default.
GEMINI_PROVIDER_ORIGIN=https://gemini.google.com
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_DELAY_MS=800

GEMINI_MAX_CONCURRENCY=1
GEMINI_MAX_ACCOUNT_CONCURRENCY=1
GEMINI_ACCOUNT_COOLDOWN_SECONDS=60
GEMINI_ACCOUNT_PROBE_SECONDS=60
GEMINI_TASK_WORKERS=1
GEMINI_MAX_TASK_QUEUE=20
GEMINI_TASK_RETENTION_HOURS=168
GEMINI_QUEUE_TIMEOUT=30
GEMINI_MAX_MESSAGES=50
GEMINI_MAX_PROMPT_CHARS=200000
GEMINI_MAX_REQUEST_BYTES=1048576

GEMINI_DATA_DIR=gateway_data
GEMINI_ACCOUNTS_FILE=gateway_data/accounts.local.json
GEMINI_PUBLIC_BASE_URL=http://127.0.0.1:8000
GEMINI_ENABLED_GENERATIONS=image,video,audio,music,deep_research,canvas
GEMINI_CORS_ORIGINS=
GEMINI_COOKIE_SYNC_ENABLED=false
GEMINI_REMOTE_ADMIN_ENABLED=false
